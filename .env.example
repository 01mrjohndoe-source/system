# Local development: existing SQLite file
TURSO_DATABASE_URL=file:./data/monitor.db
TURSO_AUTH_TOKEN=

# Production: set a persistent Turso/libSQL URL and token in Vercel.
# Example URL format: libsql://your-db-your-org.turso.io
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Protect manual collection; use a long random secret.
MONITOR_API_SECRET=
# Vercel Cron can use CRON_SECRET (Authorization: Bearer <secret>).
CRON_SECRET=
